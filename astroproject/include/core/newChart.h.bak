			memcpy(&pdchartpls.fortune.speculum2,&pdchart.fortune.fortune,sizeof(double)*4);
			memcpy(&pdchartpls.fortune.speculum, &pdchart.fortune.fortune,sizeof(double)*4);

			
			if (options.primarydir == 2 || options.primarydir == 3) // Regiomontanus Houses // ʹ�� REGIOMONTAN �� CAMPANIAN �ֹ���
			{
				for(i=0;i<14;i++) // ���������� Pds Chart �ľ���γ�Ⱥͳ����� Natal Chart
				{
					pdchartpls.planets.planets[i].speculums[1][0] =   pdchart.planets.planets[i].speculums[1][0];
					pdchartpls.planets.planets[i].speculums[1][1] =   pdchart.planets.planets[i].speculums[1][1];
					pdchartpls.planets.planets[i].speculums[1][2] =   pdchartpls.planets.planets[i].speculums[1][2]+da1;
