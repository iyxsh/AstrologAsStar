					pdchartpls.planets.planets[i].speculums[0][1] =   pdchart.planets.planets[i].speculums[0][1];
					pdchartpls.planets.planets[i].speculums[0][2] =   pdchartpls.planets.planets[i].speculums[0][2]+da1;
				}
			
