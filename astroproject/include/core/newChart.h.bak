				}
			}
			else
			{
				// ����
				if (moonSyz2.abovehorizon)
				{
					this->lons[add]=moonSyz2.data[LON];
					add++;
				}
				else
				{
					Planet sun2;
					sun2.PlanetInit(this->time2.jd, SE_SUN, this->flags,NULL,NULL,0.0,NULL,NULL,FALSE,0.0,0);
					this->lons[add]=sun2.data[LON];
					add++;
				}
