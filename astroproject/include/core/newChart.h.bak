int CompareContent(const void *data1, const void *data2)
{
	PrimDir *pContent1 = (PrimDir *)data1;
	PrimDir *pContent2 = (PrimDir *)data2;
	return pContent1->arc > pContent2->arc ? 1 : -1; 
}

