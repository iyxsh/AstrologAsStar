			double lonmoon = chart.planets.planets[SE_MOON].data[LON];// ��ʱ�������ƾ�

			int d, m, s;
			decToDeg(lonsun,&d, &m, &s);
			lonsun = d+m/60.0+s/3600.0;
			
			decToDeg(lonmoon,&d, &m, &s);
			lonmoon = d+m/60.0+s/3600.0;

			double diff1 = lonmoon-lonsun;// ̫���������Ļƾ���ֵ
			isNewMoon(diff1,&newmoon, &ready);// diff1 Ϊ�����ʾ��ǰ����Ϊ���£�ready Ϊ�����ʾ��ǰ����Ϊ���»�����
			this->newmoon=newmoon;
			this->ready=ready;

			if (! this->ready)// ��ǰ��������·�����
			{
				bool new1 = this->newmoon;
				bool ok = this->getDateHour(this->time, chart.place, this->newmoon,TRUE);// ���ҳ���ʱ���ǰһ������
				this->newmoon = new1;
