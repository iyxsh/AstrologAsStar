				pdchart.fortune.speculum[10]=fortRPR;
			else
				pdchart.fortune.speculum2[11]=fortRPR;
		}
	}
	
	lons[0] = pdchart.houses.ascmc2[0][0];
	lons[1] = pdchart.houses.ascmc2[1][0];
	
	int num=12;
	int i;
	for (i=0;i<num;i++)
	{
		pdchart.planets.planets[i].speculums[0][0]+=is.rSid;
		pdchart.planets.planets[i].speculums[1][0]+=is.rSid;
		pdchart.planets.planets[i].data[0]+=is.rSid;
		if (options.intables && ((i == SE_URANUS && ! options.transcendental[0]) || (i == SE_NEPTUNE && ! options.transcendental[1]) || (i == SE_PLUTO && ! options.transcendental[2]) || (i == SE_MEAN_NODE && ! options.shownodes)))
			continue;
		lons[i+2] = pdchart.planets.planets[i].data[0];
	}
	pdchart.fortune.fortune[0]+=is.rSid;

	lons[14] = pdchart.fortune.fortune[0];

	////////////////////////////////////////////////////////////////
	wcscpy(keytypetxt, L"Dynamic Key");
	wcscpy(keytxt ,    tListDyn[options.pdkeyd]); // options.pdkeyd=1
	
	if(!options.pdkeydyn) // ��̬��
	{
		wcscpy(keytypetxt, L"Static Key");
		wcscpy(pdkeytxt  , tListStat[options.pdkeys]);
	}

	if (!options.pdkeydyn)
		wcscpy(keytxt , tListStat[options.pdkeys]);
	
	wcscpy(txtdir , L"D");
	if (*direct==1)
		wcscpy(txtdir , L"C");
	
	wcscpy(dirtxt , tListDirs[options.primarydir]);
	
	if(options.subprimarydir==0)
		wcscpy(MZtxt,L"Mundane");
	else
		wcscpy(MZtxt,L"Zodiacal");

	return 0;
}

typedef struct  
{
  int no;
  int no2;
  int year;
  int month;
  int day;
  int hour;
  int min;
  bool ok;
} zrs;

class ZodRelL1
{
public:
	int y;
	int m;
	int d;
	int h;
	int mi;
	int sign1;
	//int period1;
	int num;
	int planper[12];
	zrs zrsA[120];
	wchar_t disp[120][120];
	
	ZodRelL1(){};
	void ZodRelL1Init(Time time1)
	{
		planper[0]=15;
		planper[1]=8;
		planper[2]=20;
		planper[3]=25;
		planper[4]=19;
		planper[5]=20;
		planper[6]=8;
		planper[7]=15;
		planper[8]=12;
		planper[9]=30;
		planper[10]=30;
		planper[1]=12;
		y = time1.origyear;
		m = time1.origmonth;
		d = time1.origday;
		h = time1.hour;
		mi = time1.minute;
		sign1 = options.ZodRelsign;
		num=0;
		memset(&zrsA,0,sizeof(zrs)*120);
		memset(&disp,0,120*120);
	}
	
	void calc()
	{
		Place place1;
		Time startdate,sd;
		startdate.time(this->y, this->m, this->d, this->h, this->mi, 0, GREENWICH, TRUE, 0, ciCore.dst, chart.place, FALSE);
		sd.time(startdate.year, startdate.month, startdate.day, startdate.hour, startdate.minute, 0, GREENWICH, TRUE, 0, ciCore.dst, chart.place, FALSE);
		
		double daysperyear = 360.0;
		if (!options.zregyptian)
			daysperyear = 365.25;
		
		int planper[12] = {15, 8, 20, 25, 19, 20, 8, 15, 12, 30, 30, 12};
		if (options.zr27cap)
			planper[9] = 27;
		else
			planper[9] = 30;
		
		int period2 = 0;
		bool go = TRUE;
		while(go)
		{
			if (options.ZodRelperiod == period2)
			{
				go = FALSE;
				break;
			}
			
			zrsA[num].no=this->sign1;
			zrsA[num].no2=1;
			zrsA[num].year=sd.year;
			zrsA[num].month=sd.month;
			zrsA[num].day=sd.day;
			zrsA[num].hour=sd.hour;
			zrsA[num].min=sd.minute;
			zrsA[num].ok=FALSE;
			this->num++;
			Time sdsub;
			sdsub.time(sd.year, sd.month, sd.day, sd.hour, sd.minute, 0, GREENWICH, TRUE, 0, ciCore.dst, chart.place, FALSE);
			
			int signsub = this->sign1;
			bool gosub = TRUE;
			bool lb = FALSE;
			bool waslb = FALSE;
			int months = 0;
			while(gosub)
			{
				double diff = (daysperyear/12.0) * planper[signsub];// 450
				
				double t1;
				
				bool caltype = (
					sdsub.year < 1582  || 
					(sdsub.year == 1582 && (sdsub.month < 10 || sdsub.month == 10 && sdsub.day < 15)
					)) ? 0 : 1;
				
				double d1 = swe_julday(sdsub.year, sdsub.month, sdsub.day, 0, caltype)+diff;
				swe_revjul(d1, caltype, &sdsub.year, &sdsub.month, &sdsub.day, &t1);
				sdsub.time(  sdsub.year, sdsub.month, sdsub.day,  sdsub.hour, sdsub.minute, 0,    0,  FALSE, ciCore.zon, ciCore.dst, chart.place, FALSE);
				
				months += planper[signsub];
				if (months/12.0 > planper[this->sign1])
				{
					gosub = FALSE;
					break;
				}
				int signsubid = signsub+1;
				if (signsubid > 11)
					signsubid = 0;
				
				if (!waslb && this->sign1 == signsubid)
				{
					signsub += int(12/2);
					if (signsub >= 12)
						signsub -= 12;
					lb = TRUE;
					signsubid = signsub+1;
					waslb = TRUE;
				}
				else
					lb = FALSE;
				
				zrsA[num].no=signsubid;
				zrsA[num].no2=2;
				zrsA[num].year=sdsub.year;
				zrsA[num].month=sdsub.month;
				zrsA[num].day=sdsub.day;
				zrsA[num].hour=sdsub.hour;
				zrsA[num].min=sdsub.minute;
				zrsA[num].ok=lb;
				this->num++;
				
				signsub = signsub+1;
				if (signsub > 11)
					signsub = 0;
			}
			
			period2 += 1;
			
			double diff = daysperyear*planper[this->sign1];
			//sd = sd+diff;
			bool caltype = (
				sd.year < 1582  || 
				(sd.year == 1582 && (sd.month < 10 || sd.month == 10 && sd.day < 15)
				)) ? 0 : 1;
			
			double t1;
			double d1 = swe_julday(sd.year, sd.month, sd.day, 0, caltype)+diff;
			swe_revjul(d1, caltype, &sd.year, &sd.month, &sd.day, &t1);
			sdsub.time(sd.year, sd.month, sd.day, sd.hour, sd.minute, 0, GREENWICH, TRUE, 0, ciCore.dst, chart.place, FALSE);
			
			if (sd.year-startdate.year > 10000)	//safety, not to have an infinite loop
				go = FALSE;
			
			waslb = FALSE;
			
			this->sign1 = this->sign1+1;
			if (this->sign1 > 11)
				this->sign1 = 0;
		}
		printZodRel();
	}

	void printZodRel()
	{
		wchar_t signtxt[120]={0};
		wchar_t leveltxt[120]={0};
		wchar_t offstxt[120]={0};
		wchar_t lbtxt[120]={0};
		wchar_t datetxt[120]={0};
		wchar_t signs[12][20];

		wcscpy(signs[0],  char_to_wchar(tSignName[1]) );
		wcscpy(signs[1],  char_to_wchar(tSignName[2]) );
		wcscpy(signs[2],  char_to_wchar(tSignName[3]) );
		wcscpy(signs[3],  char_to_wchar(tSignName[4]) );
		wcscpy(signs[4],  char_to_wchar(tSignName[5]) );
		wcscpy(signs[5],  char_to_wchar(tSignName[6]) );
		wcscpy(signs[6],  char_to_wchar(tSignName[7]) );
		wcscpy(signs[7],  char_to_wchar(tSignName[8]) );
		wcscpy(signs[8],  char_to_wchar(tSignName[9]) );
		wcscpy(signs[9],  char_to_wchar(tSignName[1]) );
		wcscpy(signs[10], char_to_wchar(tSignName[11]));
		wcscpy(signs[11], char_to_wchar(tSignName[12]));
		
		for (int i=0;i < this->num ;i++)
		{
			swprintf(signtxt,sizeof(signtxt)/sizeof(wchar_t),L"%s",signs[zrsA[i].no]);
			
			
			wcscpy(offstxt,L"");

			if (zrsA[i].no2 == 1)
			{
				//strcat(leveltxt , "/L2");
				swprintf(leveltxt,sizeof(leveltxt)/sizeof(wchar_t),L"  L%d/L2",zrsA[i].no2);
				wcscpy(offstxt, L"\r\n");
			}
			else
			{
				swprintf(leveltxt,sizeof(leveltxt)/sizeof(wchar_t),L"L%d",zrsA[i].no2);
				wcscpy(offstxt, L"     ");
			}
			wcscpy(lbtxt , L"");

			if(zrsA[i].ok==TRUE)
				wcscpy(lbtxt, L" --- LB");
			
			swprintf(datetxt,sizeof(datetxt)/sizeof(wchar_t),L"%04d/%02d/%02d",
				this->zrsA[i].year,
				this->zrsA[i].month,
				this->zrsA[i].day);
			
			wcscpy(disp[i],L"");
			wchar_t disp1[120];
			swprintf(disp1,sizeof(disp1)/sizeof(wchar_t),L"%s %20s %s %s %s",offstxt, signtxt, leveltxt, datetxt, lbtxt);
			wcscpy(disp[i],disp1);
		}
	}

};

typedef struct _Obj {
	int obj;
	double lon;
} Obj;

int CompareContent2(const void *data1, const void *data2)
{
	Obj *pContent1 = (Obj *)data1;
	Obj *pContent2 = (Obj *)data2;
	return pContent1->lon > pContent2->lon ? 1 : -1; 
}

class Decennial
{
public:
	int sSIGN; //= 0
	int sLEVEL; //= 1
	int sYEAR; //= 2
	int sMONTH; //= 3
	int sDAY; //= 4
	int sHOUR; //= 5
	int sMINUTE; //= 6
	int sLB; //= 7
	int y;
	int m;
	int d;
	int h;
	int mi;
	int sign1;
	int period1;
	int num;
	int planper[12];// = [15, 8, 20, 25, 19, 20, 8, 15, 12, 30, 30, 12]
	zrs zrsA[120];
	wchar_t disp[120][120];
	
	Decennial(){};
	void DecennialInit(Time time1)
	{//                           0 Ari     6  
		sSIGN = 0;
		sLEVEL = 1;
		sYEAR = 2;
		sMONTH = 3;
		sDAY = 4;
		sHOUR = 5;
		sMINUTE = 6;
		sLB = 7;
		
		planper[0]=15;
		planper[1]=8;
		planper[2]=20;
		planper[3]=25;
		planper[4]=19;
		planper[5]=20;
		planper[6]=8;
		planper[7]=15;
		planper[8]=12;
		planper[9]=30;
		planper[10]=30;
		planper[1]=12;
		y = time1.origyear;
		m = time1.origmonth;
		d = time1.origday;
		h = time1.hour;
		mi = time1.minute;
		sign1 = options.ZodRelsign;
		period1 = options.ZodRelperiod;
		num=0;
		memset(&zrsA,0,sizeof(zrs)*120);
		memset(&disp,0,120*120);
	}
	
	void calc()
	{
		//startdate
		Place place1;
		Time startdate,sd;
		startdate.time(this->y, this->m, this->d, this->h, this->mi, 0, GREENWICH, TRUE, 0, ciCore.dst, chart.place, FALSE);
		sd.time(startdate.year, startdate.month, startdate.day, startdate.hour, startdate.minute, 0, GREENWICH, TRUE, 0, ciCore.dst, chart.place, FALSE);
		
//�����̵Ĵ��˷���˳��Ϊ̫��-����-ˮ��-����-����-ľ��-���ǣ�
//��ҹ���̵�Ϊ          ����-����-ľ��-����-̫��-����-ˮ�ǡ�
//����30��ľ��12������15��̫��19������8��ˮ��20������25��         �� 129
//����ҹ��  isDayBirth=1 Ϊ���գ���֮Ϊҹ��
		
		double daysperyear = 360.0;

		if (!options.zregyptian)
			daysperyear = 365.25;
		
		int planper[12] = {15, 8, 20, 25, 19, 20, 8, 15, 12, 30, 30, 12};
		if (options.zr27cap)
			planper[9] = 27;         //this
		else
			planper[9] = 30;
		
		int objorder[7];

		int days[7];
		// �����˵�����
		//�����̵Ĵ��˷���˳��Ϊ̫��-����-ˮ��-����-����-ľ��-���ǣ�
		//��ҹ���̵�Ϊ          ����-����-ľ��-����-̫��-����-ˮ�ǡ�

		int daysO[7];
		daysO[0]=19*30;//̫��
		daysO[1]=25*30;//����
		daysO[2]=20*30;//ˮ��
		daysO[3]=8*30; //����
		daysO[4]=15*30;//����
		daysO[5]=12*30;//ľ��
		daysO[6]=30*30;//����

		if(isDayBirth) // ������̫����ʼ����
		{
			// ̫��-����-ˮ��-����-����-ľ��-���ǣ�
			days[0]=19*30;
			days[1]=8*30;
			days[2]=20*30;
			days[3]=25*30;
			days[4]=30*30;
			days[5]=12*30;
			days[6]=15*30;
		}
		else
		{
			//�����ƹ�25���£�����30��/�£��õ�750��������   ����30��ľ��12������15��̫��19������8��ˮ��20������25
			days[0]=25*30;
			days[1]=30*30;
			days[2]=12*30;
			days[3]=15*30;
			days[4]=19*30;
			days[5]=8*30;
			days[6]=20*30;
			// ����-����-ľ��-����-̫��-����-ˮ�ǡ�
		}

		if(isDayBirth)
		{
			//�����̵Ĵ��˷���˳��Ϊ̫��-����-ˮ��-����-����-ľ��-���ǣ�
			if(options.PlanetOrder==0) // Chaldean order
			{
				objorder[0]=1;
				objorder[1]=4;
				objorder[2]=3;
				objorder[3]=2;
				objorder[4]=7;
				objorder[5]=6;
				objorder[6]=5;
			}
			else  // In zodiacal order
			{
				// ȷ�������ڻƵ��е�˳��
				Obj obj[7];
				obj[0].obj=1;
				obj[0].lon=cp0.longitude[1];

				obj[1].obj=2;
				obj[1].lon=cp0.longitude[2];

				obj[2].obj=3;
				obj[2].lon=cp0.longitude[3];

				obj[3].obj=4;
				obj[3].lon=cp0.longitude[4];

				obj[4].obj=5;
				obj[4].lon=cp0.longitude[5];

				obj[5].obj=6;
				obj[5].lon=cp0.longitude[6];

				obj[6].obj=7;
				obj[6].lon=cp0.longitude[7];

				qsort(obj, 7, sizeof(Obj), CompareContent2);
				int moonpos=0;

				int search=options.StartWith;
				int i;
				for(i=0;i<7;i++)
				{
					// search for sun position
					if(search==0)
					{
						if(obj[i].obj==1)
						{
							moonpos=i;
							break;
						}
					}
					else
					{
						if(obj[i].obj==search)
						{
							moonpos=i;
							break;
						}
					}
				}
				for(i=0;i<7;i++)
				{
					int ii = moonpos+i;
					if(ii>6)
						ii=ii-7;
					objorder[i]=obj[ii].obj;
				}
				days[0]=daysO[objorder[0]-1];
				days[1]=daysO[objorder[1]-1];
				days[2]=daysO[objorder[2]-1];
				days[3]=daysO[objorder[3]-1];
				days[4]=daysO[objorder[4]-1];
				days[5]=daysO[objorder[5]-1];
				days[6]=daysO[objorder[6]-1];
			}
		}
		else
		{
			if(options.PlanetOrder==0) // Chaldean order
				// ��ҹ���̵�Ϊ          ����-����-ľ��-����-̫��-����-ˮ�ǡ�
			{
				objorder[0]=2;
				objorder[1]=7;
				objorder[2]=6;
				objorder[3]=5;
				objorder[4]=1;
				objorder[5]=4;
				objorder[6]=3;
			}
			else  // In zodiacal order
			{
				// ȷ�������ڻƵ��е�˳�� ҹ������������ʼ
				Obj obj[7];
				obj[0].obj=1;
				obj[0].lon=cp0.longitude[1];

				obj[1].obj=2;
				obj[1].lon=cp0.longitude[2];

				obj[2].obj=3;
				obj[2].lon=cp0.longitude[3];

				obj[3].obj=4;
				obj[3].lon=cp0.longitude[4];

				obj[4].obj=5;
				obj[4].lon=cp0.longitude[5];

				obj[5].obj=6;
				obj[5].lon=cp0.longitude[6];

				obj[6].obj=7;
				obj[6].lon=cp0.longitude[7];

				qsort(obj, 7, sizeof(Obj), CompareContent2);
				int moonpos=0;

				int search=options.StartWith;
				int i;
				for(i=0;i<7;i++)
				{
					// search for moon position
					if(search==0) // ����ҹ��
					{
						if(obj[i].obj==2)
						{
							moonpos=i;
							break;
						}
					}
					else
					{
						if(obj[i].obj==search)
						{
							moonpos=i;
							break;
						}
					}
				}
				for(i=0;i<7;i++)
				{
					int ii = moonpos+i;
					if(ii>6)
						ii=ii-7;
					objorder[i]=obj[ii].obj;
				}
				days[0]=daysO[objorder[0]-1];
				days[1]=daysO[objorder[1]-1];
				days[2]=daysO[objorder[2]-1];
				days[3]=daysO[objorder[3]-1];
				days[4]=daysO[objorder[4]-1];
				days[5]=daysO[objorder[5]-1];
				days[6]=daysO[objorder[6]-1];
			}
		}

		for(int i=0;i<7;i++)
		{
			zrsA[num].no=objorder[i];
			zrsA[num].no2=1;
			zrsA[num].year=sd.year;
			zrsA[num].month=sd.month;
			zrsA[num].day=sd.day;
			zrsA[num].hour=sd.hour;
			zrsA[num].min=sd.minute;
			zrsA[num].ok=FALSE;
			this->num++;

			Time sdsub;
			sdsub.time(sd.year, sd.month, sd.day, sd.hour, sd.minute, 0, GREENWICH, TRUE, 0, ciCore.dst, chart.place, FALSE);
			
			for(int j=0;j<6;j++)
			{
				double diff = days[j];
				double t1;
				
				bool caltype = (
					sdsub.year < 1582  || 
					(sdsub.year == 1582 && (sdsub.month < 10 || sdsub.month == 10 && sdsub.day < 15)
					)) ? 0 : 1;
				
				double d1 = swe_julday(sdsub.year, sdsub.month, sdsub.day, 0, caltype)+diff;
				swe_revjul(d1, caltype, &sdsub.year, &sdsub.month, &sdsub.day, &t1);
				sdsub.time(  sdsub.year, sdsub.month, sdsub.day,  sdsub.hour, sdsub.minute, 0, 0, FALSE, ciCore.zon, ciCore.dst, chart.place, FALSE);
				
				int a=i+j+1;
				while(a>6)
					a=a-7;
				zrsA[num].no=objorder[a];
				zrsA[num].no2=2;
				zrsA[num].year=sdsub.year;
				zrsA[num].month=sdsub.month;
				zrsA[num].day=sdsub.day;
				zrsA[num].hour=sdsub.hour;
				zrsA[num].min=sdsub.minute;
				this->num++;
			}
			
			double diff = 3870;

			bool caltype = (
				sd.year < 1582  || 
				(sd.year == 1582 && (sd.month < 10 || sd.month == 10 && sd.day < 15)
				)) ? 0 : 1;
			
			double t1;
			double d1 = swe_julday(sd.year, sd.month, sd.day, 0, caltype)+diff;
			swe_revjul(d1, caltype, &sd.year, &sd.month, &sd.day, &t1);
			sdsub.time(sd.year, sd.month, sd.day, sd.hour, sd.minute, 0, GREENWICH, TRUE, 0, ciCore.dst, chart.place, FALSE);
		}
		printZodRel();
	}

	void printZodRel()
	{
		wchar_t signtxt[120]={0};
		wchar_t leveltxt[120]={0};
		wchar_t offstxt[120]={0};
		wchar_t lbtxt[120]={0};
		wchar_t datetxt[120]={0};

		for (int i=0;i < this->num ;i++)
		{
			swprintf(signtxt,sizeof(signtxt)/sizeof(wchar_t),L"%s",tObjName[zrsA[i].no]);
			
			wcscpy(offstxt,L"");

			if (zrsA[i].no2 == 1)
			{
				swprintf(leveltxt,sizeof(leveltxt)/sizeof(wchar_t),L"  L%d/L2",zrsA[i].no2);
				wcscpy(offstxt, L"\r\n");
			}
			else
			{
				wcscpy(offstxt, L"     ");
				swprintf(leveltxt,sizeof(leveltxt)/sizeof(wchar_t),L"L%d",zrsA[i].no2);
			}

			wcscpy(lbtxt , L"");

		
			swprintf(datetxt,sizeof(datetxt)/sizeof(wchar_t),L"%04d/%02d/%02d",
				this->zrsA[i].year,
				this->zrsA[i].month,
				this->zrsA[i].day);
			
			wcscpy(disp[i],L"");
			wchar_t disp1[120];
			swprintf(disp1,sizeof(disp1)/sizeof(wchar_t),L"%s %20s %s %s %s",offstxt, signtxt, leveltxt, datetxt, lbtxt);
			wcscpy(disp[i],disp1);
		}
	}

};