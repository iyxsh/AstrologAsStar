# 预构建工具链镜像：builder-windows（MinGW-w64 交叉，加速 CI，2026-09-04 定稿）
# base = ubuntu:22.04（平台矩阵中 windows 的构建宿主）；预装 mingw-w64 后，
# job script 的 CROSS=mingw 分支 apt-get install mingw-w64 命中缓存秒过
FROM ubuntu:22.04
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.ustc.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.ustc.edu.cn/ubuntu|g' /etc/apt/sources.list && \
    apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq cmake make g++ mingw-w64 && \
    rm -rf /var/lib/apt/lists/*
