# 预构建工具链镜像：builder-alpine-3.20（加速 CI，2026-09-04 定稿）
# Alpine 自带 ca-certificates，可用 https；apk 源替换规则与 CI before_script 同源
# 源选型实测（2026-09-04）：USTC alpine 出口 ~7KB/s（35MB cmake 包卡 1h+），aliyun ~104KB/s —— 用 aliyun
FROM alpine:3.20
RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.aliyun.com|g' /etc/apk/repositories && \
    apk add --no-cache cmake make g++
